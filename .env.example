# PostgreSQL connection string. Apply Drizzle migrations before using Newsletter.
DATABASE_URL=postgresql://user:password@localhost:5432/correct_student
# Set to true only behind a VPS reverse proxy that overwrites x-real-ip.
TRUST_PROXY_IP_HEADERS=false

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Next.js dev may bind any free port; leaving this unset lets better-auth trust
# the request origin in development. Set it to your deployed origin in production.
BETTER_AUTH_URL=http://localhost:3000

